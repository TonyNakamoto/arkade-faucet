# Copy this file to .env and adjust (optional).
# cp env.example .env

# Local: use phrase file (never commit phrase.txt)
ARKADE_MNEMONIC_FILE=./phrase.txt

# Production (Render/Fly): set ARKADE_MNEMONIC in the dashboard instead — do not commit.
# ARKADE_MNEMONIC=word1 word2 ... word12

FAUCET_PUBLIC_URL=http://localhost:5000/
# Drip size is set in code (not read from env): arkade_logic.js DRIP_AMOUNT and faucet_info.js drip — keep them equal.

# Site-wide default (all routes except /health). Lower cuts dumb scanners. Default 20.
# FAUCET_GLOBAL_PER_MINUTE=20

# POST /claim: minimum seconds between requests from the same IP (set 0 to disable). Default 4.
# FAUCET_CLAIM_MIN_SECONDS=4

# After this many failed claim attempts per IP (invalid ark, node error, honeypot) within the window → temporary block.
# FAUCET_CLAIM_FAIL_WINDOW_MIN=10
# FAUCET_CLAIM_FAIL_THRESHOLD=6
# FAUCET_CLAIM_FAIL_BLOCK_SEC=600

# Burst + hourly rate limits (per client IP). Defaults: 4/min, 8/hour.
# FAUCET_CLAIM_BURST=4 per minute
# FAUCET_CLAIM_PER_HOUR=8 per hour
# FAUCET_LIGHTNING_INVOICE_BURST=5 per minute
# FAUCET_LIGHTNING_INVOICE_PER_HOUR=20 per hour

# JSON lines to stderr for claim flow (Render logs). Set to 0 to disable.
# FAUCET_CLAIM_LOG=0
